  m_Script: {fileID: 11500000, guid: 00c68ee4d7dceb346ba4f60d3f40e2cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcID: Daisy_Elevator
  npcName: Daisy
  dialogueLines:
  - 'Ok, I need to get out as soon as possible! '
  - 'It looks like you''re in a pickle! '
  - '(surprised) DAISY! What happened to you? '
  - "Sorry about that, I was sleeping, or you could say \u201CWither- "
  - 'Seriously? Did you even know what happened at the Party? '
  - 'I would like to be honest, but I don''t seem to recall anything last thing I
    heard was you talking to Gurt. '
  - 'Gotcha. Um, do you know anything about how this elevator works? '
  - "Uhhh\u2026 I am just a flower, not an engineer. I would say talk to the tenants
    on the floor. "
