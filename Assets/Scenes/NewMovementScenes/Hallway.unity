  m_Script: {fileID: 11500000, guid: 00c68ee4d7dceb346ba4f60d3f40e2cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcID: Toot
  npcName: Toot
  dialogueLines:
  - Hey there pal!
  - 'Um hi.

'
  - "Hi! Are you the new tenet moving in?\r"
  - Yeah.
  - "That\u2019s Awesome! I\u2019m glad I just met you!"
  - "I\u2019m Toot I am your next door neighbor. If you need something let me know.\r\n"
  - Oh nice to meet you.
  - Do you know the other people on this floor?
  - 'Of course I do! Why did you ask?

'
  - 'Well I am doing a house warming party so I was wondering if you could help me
    by having some guests come over?

'
  - That sounds great! I will let everyone know to come.
  - Thanks.
  speakerNames:
  - Toot
  - Player
  - Toot
  - Player
  - Toot
  - Toot
  - Player
  - Player
  - Toot
  - Player
  - Toot
