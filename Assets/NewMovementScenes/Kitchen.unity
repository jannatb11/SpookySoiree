  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00c68ee4d7dceb346ba4f60d3f40e2cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcID: Gurt_Kitchen
  npcName: Gurt
  dialogueLines:
  - DAISY?!?!?!!?!?!?
  - "Gurt gurt gurble, I\u2019ll give you a moment alone. "
  - 'Wait, can you please help me one last time? '
  - 'Gurt gurt gurble? '
  - 'Do you know the other people on this floor? '
  - 'Of course, Gurt does! Why do ya ask? '
  - "Well, I\u2019m doing a housewarming party. Can you help me invite some of them
    over? "
  - 'That sounds gurtable! I will let everyone know to come. '
  - 'Thanks, you''re a big help. '
  - 'See you later, gurble. '
  speakerNames:
  - Player
  - Gurt
  - Player
  - Gurt
