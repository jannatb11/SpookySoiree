  m_Script: {fileID: 11500000, guid: 00c68ee4d7dceb346ba4f60d3f40e2cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcID: Gurt_1
  npcName: Gurt
  animator: {fileID: 657842779}
  dialogueLines:
  - Gurt gurt gurble, to you, my dear. How are you this fine evening?
  - "Huh?!? Who are you?\r"
  - "How did you get inside my house? What are you????!?!?!?\r"
  - Why, I am Gurt. Gurt gurt gurble!
  - "\u201CGurt gurt gurble\u201D?"
  - "Yes, indeed. I come from a long line of strong, hardworking, and amazingly beautiful
    Gurts. Virtues that will be held for all time.\r"
  - "That's great. But how did you get in\u2026\u2026 "
  - 'Why, I was invited in, of course. Never mind that now, though.

'
  - "Why is that?\r\n\t"
  - 'I discovered something that might interest you. If you would kindly follow me,
    gurble.

'
  speakerNames:
  - Gurt
  - Player
  - Player
  - Gurt
  - Player
  - Gurt
  - Player
  - Gurt
  - Player
